# ── 共享配置（crawler 和 intelligence 共用此文件）─────────────────
# 复制为 .env 并填入真实值

# LLM API（支持 OpenAI 兼容接口：通义千问、DeepSeek、OpenAI 等）
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-flash

# MongoDB
MONGO_HOST=127.0.0.1
MONGO_PORT=27017

# DHT 爬虫
DHT_NODE_NUM=3
DHT_PORT=6881
FIND_NODE_INTERVAL=2.0
SAVE_INTERVAL=30.0

# intelligence 层
CHROMA_PATH=./intelligence/chroma_db
LOG_LEVEL=INFO

# 告警推送（留空则不推送该渠道）
NOTIFY_FEISHU_WEBHOOK=
NOTIFY_DINGTALK_WEBHOOK=
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
